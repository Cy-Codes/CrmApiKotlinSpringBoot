# ============================================================================
# CrmApiKotlinSpringBoot container runtime contract
# The image reads ONLY these variables, on every platform (local Docker, AWS
# ECS, Azure Container Apps). Terraform renders the cloud values from
# crm-infra/terraform/modules/shared/crm-runtime-config.
#
#   docker build -t crm-api-kotlin .
#   docker run --rm -p 8082:8080 --env-file .env crm-api-kotlin
#
# The values are the same ADO.NET-style connection strings the C# API uses;
# Spring's relaxed binding maps CONNECTIONSTRINGS_CRMDATABASEMS to the
# ConnectionStrings.CRMDatabaseMS key read by DbConnectionFactory.
# The defaults below target the CRMDatabaseMS / CRMDatabasePG containers
# started from their own docker-compose.yml files on the host.
# ============================================================================

# HTTP port inside the container
SERVER_PORT=8080

# Microsoft SQL Server (provider code: ms)
CONNECTIONSTRINGS_CRMDATABASEMS=Server=host.docker.internal,1433;Database=CRMDatabaseMS;User Id=sa;Password=CrmDev2026!Secure#Pass;Encrypt=True;TrustServerCertificate=True;

# PostgreSQL (provider code: pg)
CONNECTIONSTRINGS_CRMDATABASEPG=Host=host.docker.internal;Port=5432;Database=CRMDatabase;Username=postgres;Password=postgres;

# JWT resource server (always enforced). HS256 shared secret used to validate Bearer tokens; the `roles` claim
# (admin | user) drives authorization of POST/PUT/DELETE. Mint dev tokens with crm-infra/scripts/dev-token.sh.
# CRM_SECURITY_JWT_SECRET=LocalStackCRMReferenceArchitectureJwtSigningSecretKey2026!
# CRM_SECURITY_JWT_ISSUER=https://auth.localstack.local
# CRM_SECURITY_JWT_AUDIENCE=crm-api
