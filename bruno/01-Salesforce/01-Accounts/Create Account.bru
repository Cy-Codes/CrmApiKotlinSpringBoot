meta {
  name: Create Account (admin, 201)
  type: http
  seq: 91
}

post {
  url: {{baseUrl}}/api/{{provider}}/v1/salesforce/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {"name":"Bruno Account","ownerId":"{{sf_user_id}}","industry":"Technology"}
}

script:post-response {
  bru.setVar("sf_created_account_id", res.body.id);
}

assert {
  res.status: eq 201
  res.headers.location: contains /salesforce/accounts/
}
