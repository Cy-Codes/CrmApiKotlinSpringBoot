meta {
  name: Update Contact (user, 200)
  type: http
  seq: 92
}

put {
  url: {{baseUrl}}/api/{{provider}}/v1/salesforce/contacts/{{sf_created_contact_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  {"lastName":"Bruno-Updated","firstName":"Test","ownerId":"{{sf_user_id}}","accountId":"{{sf_account_id}}"}
}

assert {
  res.status: eq 200
}
