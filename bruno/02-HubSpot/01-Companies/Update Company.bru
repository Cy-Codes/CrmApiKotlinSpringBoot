meta {
  name: Update Company (user, 200)
  type: http
  seq: 92
}

put {
  url: {{baseUrl}}/api/{{provider}}/v1/hubspot/companies/{{hs_created_company_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  {"name":"Bruno Co Updated","domain":"bruno.example.com","city":"Austin"}
}

assert {
  res.status: eq 200
}
