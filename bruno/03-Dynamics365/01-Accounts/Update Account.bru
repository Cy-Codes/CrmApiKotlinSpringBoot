meta {
  name: Update Account (user, 200)
  type: http
  seq: 92
}

put {
  url: {{baseUrl}}/api/{{provider}}/v1/dynamics365/accounts/{{d365_created_account_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  {"name":"Bruno Account Updated","ownerId":"{{d365_system_user_id}}","owningBusinessUnit":"{{d365_business_unit_id}}"}
}

assert {
  res.status: eq 200
}
