meta {
  name: Create Contact (admin, 201)
  type: http
  seq: 91
}

post {
  url: {{baseUrl}}/api/{{provider}}/v1/dynamics365/contacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {"lastName":"Bruno","firstName":"Test","ownerId":"{{d365_system_user_id}}","owningBusinessUnit":"{{d365_business_unit_id}}"}
}

script:post-response {
  bru.setVar("d365_created_contact_id", res.body.contactId);
}

assert {
  res.status: eq 201
  res.headers.location: contains /dynamics365/contacts/
}
