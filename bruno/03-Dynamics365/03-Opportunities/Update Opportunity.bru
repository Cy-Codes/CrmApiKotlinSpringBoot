meta {
  name: Update Opportunity (user, 200)
  type: http
  seq: 92
}

put {
  url: {{baseUrl}}/api/{{provider}}/v1/dynamics365/opportunities/{{d365_created_opportunity_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  {"name":"Bruno Opportunity Updated","ownerId":"{{d365_system_user_id}}","owningBusinessUnit":"{{d365_business_unit_id}}","estimatedValue":2500.00}
}

assert {
  res.status: eq 200
}
