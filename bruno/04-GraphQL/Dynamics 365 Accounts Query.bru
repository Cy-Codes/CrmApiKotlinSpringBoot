meta {
  name: GraphQL - Dynamics 365 Accounts
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query {
    dynamics365Accounts(page: 1, pageSize: 5) {
      accountId
      name
    }
  }
}

assert {
  res.status: eq 200
  res.body.data: isDefined
}
