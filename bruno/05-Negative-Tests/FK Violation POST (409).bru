meta {
  name: POST Account With Unknown Owner (409)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/{{provider}}/v1/salesforce/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {"name":"Bad Owner","ownerId":"005NOSUCHUSER00000"}
}

assert {
  res.status: eq 409
  res.body.title: eq Conflict
}
